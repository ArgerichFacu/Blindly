{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "ios-simulator": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    },
    "play-testing": {
      "extends": "production",
      "environment": "preview",
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_PLUS_READY": "true" }
    }
  },
  "submit": {
    "production": {}
  }
}
