{
  "expo": {
    "name": "Blindly",
    "slug": "blindly",
    "version": "1.39",
    "orientation": "portrait",
    "icon": "./assets/brand/blindly-icono-1024.png",
    "scheme": "blindly",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.blindly.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1512",
        "foregroundImage": "./assets/brand/blindly-adaptive-foreground.png",
        "monochromeImage": "./assets/brand/blindly-adaptive-monocromo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.blindly.studio",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/blindly-icono-512.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "club",
          "color": "#5BD08A"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1512",
          "image": "./assets/brand/blindly-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0E1512",
            "image": "./assets/brand/blindly-splash.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Blindly usa la cámara para escanear el QR de una sala.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Barlow-Regular.ttf",
            "./assets/fonts/Barlow-Medium.ttf",
            "./assets/fonts/Barlow-SemiBold.ttf",
            "./assets/fonts/BarlowCondensed-SemiBold.ttf",
            "./assets/fonts/BarlowCondensed-Bold.ttf"
          ]
        }
      ],
      "expo-asset",
      "./plugins/with-revenuecat-android",
      "./plugins/with-android-page-sizes",
      "./plugins/with-android-release-optimization",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Mesa de poker presencial con turnos, ciegas, fichas y puntuación sincronizados.",
    "backgroundColor": "#0E1512",
    "primaryColor": "#0E1512",
    "githubUrl": "https://github.com/ArgerichFacu/Blindly",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f3c10b7-f501-45d8-8d64-b1ffe5569667"
      }
    },
    "owner": "facuargerich"
  }
}
