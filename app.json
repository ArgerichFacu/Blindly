{
  "expo": {
    "name": "Blindly",
    "slug": "blindly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/blindly-logo.png",
    "scheme": "blindly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.blindly.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1713",
        "foregroundImage": "./assets/images/blindly-logo-transparent.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.blindly.app",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1713",
          "image": "./assets/images/blindly-logo.png",
          "imageWidth": 360,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A1713",
            "image": "./assets/images/blindly-logo.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Blindly usa la cámara para escanear el QR de una sala.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "./plugins/with-revenuecat-android"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Mesa de poker presencial con turnos, ciegas, fichas y puntuación sincronizados.",
    "backgroundColor": "#0A1713",
    "primaryColor": "#0A1713",
    "githubUrl": "https://github.com/ArgerichFacu/Blindly",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f3c10b7-f501-45d8-8d64-b1ffe5569667"
      }
    },
    "owner": "facuargerich"
  }
}
