# Copiar a .env y completar con los valores públicos del proyecto Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Auth convencional requiere SMTP/Google y redirects en Supabase.
# Ver docs/auth-convencional.md; no se activa mediante una bandera del cliente.
# Habilitar sólo con credenciales FCM/APNs probadas y una compilación nativa nueva.
EXPO_PUBLIC_PUSH_READY=false

# Activar únicamente después de configurar y probar los productos nativos.
EXPO_PUBLIC_PLUS_READY=false
# La prueba Founder no depende de esta bandera. Los pagos también requieren
# real_payments_enabled=true en Supabase; actualmente están deshabilitados.
# Ver docs/founder-trial.md.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob (cargar en EAS, entorno de la build de tienda; no son secretos pero no se versionan).
# Sin estas variables la app sólo usa los IDs de prueba de Google y no muestra anuncios reales.
# Activar anuncios además requiere private.publicidad_config.ads_enabled=true en Supabase.
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
