# Copiar a .env y completar con los valores públicos del proyecto Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Mantener false hasta configurar SMTP y verificar la recuperación por correo.
EXPO_PUBLIC_EMAIL_AUTH_READY=false

# Activar únicamente después de configurar y probar los productos nativos.
EXPO_PUBLIC_PLUS_READY=false
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
